# Android build output
src/.gradle/
src/app/build/
src/.kotlin/
src/build/

# Local config (machine-specific)
src/local.properties

# IDE
src/.idea/
*.iml

# Keys / signing — NEVER commit these. This is a public repo; a committed
# keystore + its passwords hands anyone the app's release signing identity, and
# a committed bearer token is a live credential. Signing material and secrets
# live only on the build machine (or in CI secrets), never in git.
*.jks
*.keystore
keystore.properties
src/keystore.properties

# OS
.DS_Store
